# =================================
# Pitwall Analytics Configuration
# =================================

# Backend API Settings (FastAPI)
API_ENV=development
API_DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
API_HOST=127.0.0.1
API_PORT=5000
API_TITLE=Pitwall Analytics API
API_VERSION=2.0.0

# Dash Frontend Settings
DASH_DEBUG=True
DASH_HOST=127.0.0.1
DASH_PORT=8050

# Backend API URL (for frontend to connect)
BACKEND_API_URL=http://127.0.0.1:5000/api

# FastF1 Cache Settings
CACHE_DIR=.ff1cache
CACHE_ENABLED=True

# CORS Settings (comma-separated origins for backend/config.py)
CORS_ORIGINS=http://localhost:8050,http://127.0.0.1:8050

# CORS for production API (comma-separated, e.g. your Cloud Run URL)
# Leave empty to allow all origins (safe for public read-only APIs)
CORS_ALLOW_ORIGINS=https://your-service.run.app

# API Security
# Set to 'true' in development to enable /api/docs and /api/redoc
ENABLE_API_DOCS=false
# Secret key for admin endpoints (generate: openssl rand -hex 32)
ADMIN_API_KEY=your-admin-api-key-here

# Rate Limiting (requests per minute per IP)
RATE_LIMIT_HEAVY=20/minute
RATE_LIMIT_LIGHT=60/minute

# App Settings
APP_TITLE=Pitwall Analytics
REQUEST_TIMEOUT=30

# Cache Database Settings (SQLite)
DB_DIR=data
DB_NAME=pitwall_cache.db
CACHE_TTL_SECONDS=3600
EXTERNAL_API_TIMEOUT=30
