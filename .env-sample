# =================================
# Pitwall Analytics Configuration
# Copie este arquivo para .env e preencha os valores
# =================================

# Backend API Settings (FastAPI)
API_ENV=development
API_DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
API_HOST=127.0.0.1
API_PORT=5000
API_TITLE=Pitwall Analytics API
API_VERSION=2.0.0

# Dash Frontend Settings
DASH_DEBUG=True
DASH_HOST=127.0.0.1
DASH_PORT=8050

# Backend API URL (for frontend to connect)
BACKEND_API_URL=http://127.0.0.1:5000/api

# FastF1 Cache Settings
CACHE_DIR=.ff1cache
CACHE_ENABLED=True

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:8050,http://127.0.0.1:8050

# App Settings
APP_TITLE=Pitwall Analytics
REQUEST_TIMEOUT=30

# Cache Database Settings (SQLite)
DB_DIR=data
DB_NAME=pitwall_cache.db
CACHE_TTL_SECONDS=3600
EXTERNAL_API_TIMEOUT=30

# Google Cloud Storage
# Nome do bucket onde o banco SQLite será armazenado
GCS_BUCKET_NAME=your-bucket-name

# Caminho do arquivo dentro do bucket
GCS_DB_BLOB_PATH=db/pitwall_cache.db

# Credenciais (deixe vazio em produção no GCloud — usa metadata server automático)
# Em desenvolvimento local, aponte para o JSON da service account:
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/sa-key.json
GOOGLE_APPLICATION_CREDENTIALS=
